# Server-only placeholders. Never use NEXT_PUBLIC_ for any of these.
DATABASE_URL=postgresql://APP_USER:APP_PASSWORD@localhost:5432/kalvia_development
MIGRATION_DATABASE_URL=postgresql://MIGRATOR:MIGRATOR_PASSWORD@localhost:5432/kalvia_development
MAINTENANCE_DATABASE_URL=postgresql://MAINTENANCE:MAINTENANCE_PASSWORD@localhost:5432/kalvia_development
CONTACT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CONTACT_RATE_LIMIT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Optional: only set if your hosting ingress overwrites this header with ONE trusted IP.
CONTACT_CLIENT_IP_HEADER=
# Optional PEM CA certificate for remote database TLS (system CAs are the default).
DATABASE_CA_CERT=
# Optional existing local admin connection for db:setup-local. Never deploy this.
LOCAL_POSTGRES_ADMIN_URL=
# Temporarily use true when checking a production build before CSP enforcement.
CSP_REPORT_ONLY=false
# Set only after verifying HTTPS and its request origin at the deployed app.
# Exact origin, no trailing slash; no includeSubDomains or preload are enabled.
SECURITY_HTTPS_ORIGIN=
# Confirmed canonical origin for metadata, robots and sitemap. Rebuild after changes.
SITE_ORIGIN=https://kalvia.one
